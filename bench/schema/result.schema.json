{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qwen-image-rocm benchmark result",
  "type": "object",
  "required": [
    "experiment",
    "phase",
    "framework",
    "precision",
    "width",
    "height",
    "steps",
    "seed",
    "prompt_id",
    "protocol_version",
    "runs",
    "vram_peak_mb",
    "env_ref",
    "created_at"
  ],
  "properties": {
    "experiment": { "type": "string" },
    "phase": { "type": "integer" },
    "framework": { "type": "string" },
    "precision": { "type": "string" },
    "width": { "type": "integer" },
    "height": { "type": "integer" },
    "steps": { "type": "integer" },
    "seed": { "type": "integer" },
    "prompt_id": { "type": "string" },
    "protocol_version": { "type": "string" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "total_s",
          "text_encode_s",
          "denoise_s",
          "vae_decode_s",
          "step_times_s"
        ],
        "properties": {
          "kind": { "enum": ["cold", "warm"] },
          "total_s": { "type": "number" },
          "text_encode_s": { "type": ["number", "null"] },
          "denoise_s": { "type": "number" },
          "vae_decode_s": { "type": ["number", "null"] },
          "step_times_s": { "type": "array", "items": { "type": "number" } }
        }
      }
    },
    "vram_peak_mb": { "type": "number" },
    "env_ref": { "type": "string" },
    "created_at": { "type": "string" },
    "run_kind": { "enum": ["cold", "warmup", "measure"] },
    "attention_backend": { "type": "string" }
  }
}
